# Copy this file to .env and fill in your secrets for local development.
# In production (Render/GitHub Actions) set these as environment variables
# instead so the real keys are never committed.

# SharpAPI key — required for player props / odds features
# Get one at https://sharpapi.io (starts with sk_live_)
SHARPAPI_KEY=your_sharpapi_key_here

# Optional second SharpAPI key. Each key is rate-metered independently
# (12 req/min per key), so a second key doubles the request rate and makes
# the odds/props sweeps finish ~2x faster with fewer truncations.
SHARPAPI_KEY_2=your_second_sharpapi_key_here
